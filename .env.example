# Supabase Configuration (frontend)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# For Next.js Apps
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase Configuration (backend / docker-compose)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
# Service Role Key (Keep secret! Only for backend/admin tasks. Rotate immediately if committed.)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Local InsForge PostgreSQL (used by docker-compose)
DATABASE_URL=postgres://superapp:<local-db-password>@host.docker.internal:5432/insforge

# Cloudflare Tunnel (optional, for exposing API locally)
# CLOUDFLARE_TUNNEL_TOKEN=<your-token>

# LLM API key (optional, for InsForge Gateway / DeepWiki)
# LLM_API_KEY=<your-llm-api-key>

# Optional configuration
# NODE_ENV=development
