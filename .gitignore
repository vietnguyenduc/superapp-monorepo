node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
test-results/

# Temporary agent scripts
.tmp-*.mjs
*.tmp.mjs

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

.vercel
.env*.local

# Python
__pycache__/
*.py[cod]
*.class

# Bot Data & Sessions
telegram_sessions.json
*.db
*.sqlite3
*.log
core/memory_vault/
/data/

# Agent / AI runtime files (not needed for deployment)
.agent/
.agents/
.openhands/
conversations/
screenshots/
bash_events/

# Production env (managed via Vercel dashboard)
.env.production
.env.staging

# Aider runtime/cache
.aider.chat.history.md
.aider.input.history
.aider.tags*
.aider.llm.history

super-scraper/
vaults/
scratch/
node_modules/
.turbo/
dist/
# packages/api/dist is the source of truth for the API backend (no src/ dir);
# it must be tracked so Docker/Vercel builds have the compiled code.
!packages/api/dist/
!packages/api/dist/**
dev-apps.log
apps/superapp-business-bot/scraper/storage/refined_data/

# OpenHands runtime artifacts (should not be in repo)
[0-9a-f]*/
# The rule above also matches "api/" and "dist/" (a/d are hex chars);
# re-include the API backend dist (source of truth, no src/ dir).
!packages/api/
!packages/api/dist/
!packages/api/dist/**
# Re-include apps/ and docs/ (matched by [0-9a-f]*/ because "a" and "d" are hex chars)
!apps/
!apps/**
apps/*/node_modules/
# Ignore stale compiled JS emitted into source trees by accidental tsc runs.
# Cashflow source is TypeScript; any committed .js in src/ should be intentional data/config.
apps/cashflow/src/**/*.js
# App build outputs (re-included by !apps/** above).
apps/*/dist/
!docs/
!docs/**
# Re-include shared-utils api-client directory (starts with "a")
!packages/shared-utils/src/api-client/
!packages/shared-utils/src/api-client/**
# Ignore package build outputs except packages/api/dist (source of truth).
packages/*/dist/
!packages/api/dist/
!packages/api/dist/**
conversations/
bash_events/

superapp-monorepo/
*tsbuildinfo

# Supabase local dev generated files
supabase/.branches/
supabase/.temp/
