# Telegram Configurations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_ID=your_telegram_user_id_here

# Gemini AI / NotebookLM Configurations
GEMINI_API_KEY=your_gemini_api_key_here

# Local Fallback Model Configurations (Ollama / OpenClaw)
# Auto-triggers if Gemini runs out of tokens or goes offline
FALLBACK_API_BASE=http://127.0.0.1:11434/v1
FALLBACK_MODEL_NAME=llama3.1:latest
FALLBACK_API_KEY=ollama

# Monorepo Workspace Configuration
MONOREPO_ROOT_PATH=C:\Vibecoding\superapp-monorepo

# Nvidia AI Configurations
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Devin API Configuration (delegate complex tasks from Telegram via /devin)
DEVIN_API_KEY=

