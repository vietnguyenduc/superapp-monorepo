# Telegram Configurations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_ID=your_telegram_user_id_here

# AI Provider Configurations
# DeepSeek (primary) -> Nvidia (fallback). The bot uses these for both
# the agent chat and the RAG engine.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# Deprecated (Gemini / Ollama no longer used by the business bot)
# GEMINI_API_KEY=your_gemini_api_key_here
# FALLBACK_API_BASE=http://127.0.0.1:11434/v1
# FALLBACK_MODEL_NAME=llama3.1:latest
# FALLBACK_API_KEY=ollama

# Monorepo Workspace Configuration
MONOREPO_ROOT_PATH=C:\Vibecoding\superapp-monorepo

# eSMS.vn Configurations
ESMS_API_KEY=your_esms_api_key_here
ESMS_SECRET_KEY=your_esms_secret_key_here
ESMS_BRANDNAME=Qc
ESMS_SMS_TYPE=2

