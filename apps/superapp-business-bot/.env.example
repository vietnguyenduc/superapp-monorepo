# Telegram Configurations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_TELEGRAM_USER_ID=your_telegram_user_id_here

# ═══════════════ PRIMARY AI MODEL ═══════════════
# DeepSeek (chủ lực - rẻ nhất, $0.14/1M input tokens)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Nvidia AI (secondary - nhanh, mô hình lớn)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# ═══════════════ VISUAL/EMERGENCY FALLBACK ═══════════════
# Gemini (chỉ dùng cho visual tasks hoặc khi DeepSeek+Nvidia offline)
GEMINI_API_KEY=your_gemini_api_key_here

# ═══════════════ DISABLED ═══════════════
# Ollama (disabled - gây lag PC)
# FALLBACK_API_BASE=http://127.0.0.1:11434/v1
# FALLBACK_MODEL_NAME=qwen3:8b
# FALLBACK_API_KEY=ollama

# Monorepo Workspace Configuration
MONOREPO_ROOT_PATH=C:\Vibecoding\superapp-monorepo

# eSMS.vn Configurations
ESMS_API_KEY=your_esms_api_key_here
ESMS_SECRET_KEY=your_esms_secret_key_here
ESMS_BRANDNAME=Qc
ESMS_SMS_TYPE=2
