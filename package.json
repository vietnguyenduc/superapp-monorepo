{
  "name": "superapp-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=16",
    "dev:apps": "turbo run dev --filter=accounting --filter=admin-portal --filter=cashflow --filter=framework-method --filter=hr-operation --filter=inventory-operation --filter=operations-portal --filter=sales-operation --concurrency=16",
    "lint": "turbo run lint",
    "type-check": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.2.4",
    "assertion-error": "^1.1.0",
    "check-error": "^1.0.3",
    "css-box-model": "^1.2.1",
    "deep-eql": "^4.1.4",
    "deep-equal": "^2.2.3",
    "eventemitter3": "^5.0.4",
    "get-func-name": "^2.0.2",
    "local-pkg": "^1.2.1",
    "loupe": "^2.3.7",
    "memoize-one": "^5.2.1",
    "pathval": "^1.1.1",
    "prettier": "^3.6.2",
    "psl": "^1.15.0",
    "punycode": "^2.3.1",
    "raf-schd": "^4.0.3",
    "react-redux": "^7.2.9",
    "react-smooth": "^4.0.4",
    "recharts-scale": "^0.4.5",
    "redux": "^4.2.1",
    "tiny-invariant": "^1.3.3",
    "turbo": "^2.5.5",
    "type-detect": "^4.1.0",
    "typescript": "5.8.3",
    "universalify": "^2.0.1",
    "url-parse": "^1.5.10",
    "use-memo-one": "^1.1.3",
    "victory-vendor": "^37.3.6",
    "vite": "^8.0.12",
    "void-elements": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@supabase/mcp-server-supabase": "^0.7.0"
  }
}
