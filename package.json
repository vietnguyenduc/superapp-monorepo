{
  "name": "superapp-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=16",
    "dev:apps": "turbo run dev --filter=accounting --filter=admin-portal --filter=cashflow --filter=hr-operation --filter=inventory-operation --filter=operations-portal --filter=sales-operation --concurrency=16",
    "lint": "turbo run lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3",
    "vite": "^4.4.9"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@supabase/mcp-server-supabase": "^0.7.0"
  }
}
